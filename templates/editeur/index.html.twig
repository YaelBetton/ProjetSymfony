{% extends 'base.html.twig' %}

{% block title %}Liste des éditeurs{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>Liste des éditeurs</h1>
        <a class="btn btn--primary" href="{{ path('app_editeur_new') }}">Ajouter un éditeur</a>
    </div>

    {# table--cards : sur tablette / téléphone, chaque ligne s'affiche en carte (cf. components.css) #}
    <div class="table-responsive table-responsive--cards">
        <table class="table table--cards">
            <caption class="visually-hidden">Liste des éditeurs ({{ editeurs|length }})</caption>
            <thead>
                <tr>
                    <th scope="col">Nom</th>
                    <th scope="col">Pays</th>
                    <th scope="col">Site internet</th>
                    <th scope="col">Description</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for editeur in editeurs %}
                <tr>
                    <td class="cell-title"><strong>{{ editeur.nom }}</strong></td>
                    <td data-label="Pays">{{ editeur.pays }}</td>
                    <td data-label="Site internet">{{ include('editeur/_site_web.html.twig') }}</td>
                    {# Seuls les 150 premiers caractères de la description sont affichés #}
                    <td data-label="Description">
                        {% if editeur.description|length > 150 %}
                            {{ editeur.description|slice(0, 150) }}…
                        {% else %}
                            {{ editeur.description }}
                        {% endif %}
                    </td>
                    <td class="cell-actions">
                        <div class="actions actions--table">
                            <a class="btn btn--secondary btn--sm" href="{{ path('app_editeur_show', {'id': editeur.id}) }}">Consulter<span class="visually-hidden"> {{ editeur.nom }}</span></a>
                            <a class="btn btn--secondary btn--sm" href="{{ path('app_editeur_edit', {'id': editeur.id}) }}">Modifier<span class="visually-hidden"> {{ editeur.nom }}</span></a>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="table__empty">Aucun éditeur enregistré.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
