{% extends 'base.html.twig' %}

{% block title %}Modifier l'éditeur {{ editeur.nom }}{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>Modifier l'éditeur {{ editeur.nom }}</h1>
    </div>

    {{ include('editeur/_form.html.twig', {'button_label': 'Enregistrer les modifications'}) }}

    <div class="actions">
        <a class="btn btn--secondary" href="{{ path('app_editeur_show', {'id': editeur.id}) }}">Retour à l'éditeur</a>
        <a class="btn btn--secondary" href="{{ path('app_editeur_index') }}">Retour à la liste</a>
        {{ include('editeur/_delete_form.html.twig') }}
    </div>
{% endblock %}
