{% extends 'base.html.twig' %}

{% block title %}Éditeur {{ editeur.nom }}{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>Éditeur {{ editeur.nom }}</h1>
    </div>

    <table class="table table--detail">
        <caption class="visually-hidden">Détail de l'éditeur {{ editeur.nom }}</caption>
        <tbody>
            <tr>
                <th scope="row">Nom</th>
                <td>{{ editeur.nom }}</td>
            </tr>
            <tr>
                <th scope="row">Pays</th>
                <td>{{ editeur.pays }}</td>
            </tr>
            <tr>
                <th scope="row">Site internet</th>
                <td>{{ include('editeur/_site_web.html.twig') }}</td>
            </tr>
            <tr>
                <th scope="row">Description</th>
                {# Description affichée en entier (contrairement à la liste) #}
                <td>{{ editeur.description|nl2br }}</td>
            </tr>
            <tr>
                <th scope="row">Nombre de jeux</th>
                <td>{{ editeur.jeuVideos|length }}</td>
            </tr>
            <tr>
                <th scope="row">Date de création</th>
                <td>{{ editeur.createdAt ? editeur.createdAt|date('d/m/Y H:i') : '' }}</td>
            </tr>
            <tr>
                <th scope="row">Date de modification</th>
                <td>{{ editeur.updatedAt ? editeur.updatedAt|date('d/m/Y H:i') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <div class="actions">
        <a class="btn btn--secondary" href="{{ path('app_editeur_index') }}">Revenir à la liste</a>
        <a class="btn btn--primary" href="{{ path('app_editeur_edit', {'id': editeur.id}) }}">Modifier cet éditeur</a>
        {{ include('editeur/_delete_form.html.twig') }}
    </div>
{% endblock %}
