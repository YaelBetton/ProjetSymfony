<form class="inline-form" method="post" action="{{ path('app_editeur_delete', {'id': editeur.id}) }}" onsubmit="return confirm('Confirmer la suppression de l\'éditeur « {{ editeur.nom|e('js') }} » ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ editeur.id) }}">
    <button type="submit" class="btn btn--danger">Supprimer cet éditeur</button>
</form>
