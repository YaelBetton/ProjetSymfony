{% extends 'base.html.twig' %}

{% block title %}{{ collect.jeuVideo.titre }} — collection de {{ collect.utilisateur.pseudonyme }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/collection.css') }}">
{% endblock %}

{% block body %}
    {% set jeu = collect.jeuVideo %}
    {% set utilisateur = collect.utilisateur %}

    <div class="page-header">
        <h1>{{ jeu.titre }} <span class="sous-texte">dans la collection de {{ utilisateur.pseudonyme }}</span></h1>
    </div>

    <div class="detail">
        {% if jeu.imageUrl %}
            <img class="detail__image" src="{{ asset(jeu.imageUrl) }}" alt="Jaquette de {{ jeu.titre }}">
        {% endif %}

        <table class="table table--detail">
            <caption class="visually-hidden">Détail de « {{ jeu.titre }} » dans la collection de {{ utilisateur.pseudonyme }}</caption>
            <tbody>
                <tr>
                    <th scope="row">Utilisateur</th>
                    <td><a href="{{ path('app_utilisateur_show', {'id': utilisateur.id}) }}">{{ utilisateur.pseudonyme }}</a> ({{ utilisateur.nomComplet }})</td>
                </tr>
                <tr>
                    <th scope="row">Jeu vidéo</th>
                    <td><a href="{{ path('app_jeu_video_show', {'id': jeu.id}) }}">{{ jeu.titre }}</a></td>
                </tr>
                <tr>
                    <th scope="row">Genre / Éditeur</th>
                    <td>{{ jeu.genre ? jeu.genre.nom : '' }} — {{ jeu.editeur ? jeu.editeur.nom : '' }}</td>
                </tr>
                <tr>
                    <th scope="row">Statut</th>
                    <td>{{ include('collect/_statut.html.twig', {statut: collect.statut}) }}</td>
                </tr>
                <tr>
                    <th scope="row">Statut modifié le</th>
                    <td>{{ collect.dateModifStatut ? collect.dateModifStatut|date('d/m/Y H:i') : '' }}</td>
                </tr>
                <tr>
                    <th scope="row">Prix d'achat</th>
                    <td>
                        {% if collect.prixAchat is not null %}
                            {{ collect.prixAchat|number_format(2, ',', ' ') }} €
                            {% if jeu.prix is not null %}
                                <span class="sous-texte">Prix public du jeu : {{ jeu.prix|number_format(2, ',', ' ') }} €</span>
                            {% endif %}
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th scope="row">Date d'achat</th>
                    <td>
                        {{ collect.dateAchat ? collect.dateAchat|date('d/m/Y') : '' }}
                        {% if jeu.dateSortie %}
                            <span class="sous-texte">Jeu sorti le {{ jeu.dateSortie|date('d/m/Y') }}</span>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th scope="row">Commentaire</th>
                    <td>{{ collect.commentaire|nl2br }}</td>
                </tr>
                <tr>
                    <th scope="row">Date de création</th>
                    <td>{{ collect.createdAt ? collect.createdAt|date('d/m/Y H:i') : '' }}</td>
                </tr>
                <tr>
                    <th scope="row">Date de modification</th>
                    <td>{{ collect.updatedAt ? collect.updatedAt|date('d/m/Y H:i') : '' }}</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="actions">
        <a class="btn btn--secondary" href="{{ path('app_utilisateur_show', {'id': utilisateur.id}) }}">Revenir à la collection</a>
        <a class="btn btn--primary" href="{{ path('app_collect_edit', {'id': collect.id}) }}">Modifier</a>
        {{ include('collect/_delete_form.html.twig') }}
    </div>
{% endblock %}
