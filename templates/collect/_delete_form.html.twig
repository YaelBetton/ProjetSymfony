<form class="inline-form" method="post" action="{{ path('app_collect_delete', {'id': collect.id}) }}" onsubmit="return confirm('Retirer « {{ collect.jeuVideo.titre|e('js') }} » de la collection de {{ collect.utilisateur.pseudonyme|e('js') }} ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ collect.id) }}">
    <button type="submit" class="btn btn--danger">Retirer de la collection</button>
</form>
