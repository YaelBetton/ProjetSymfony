{% extends 'base.html.twig' %}

{% block title %}Modifier {{ collect.jeuVideo.titre }} — collection de {{ collect.utilisateur.pseudonyme }}{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>Modifier « {{ collect.jeuVideo.titre }} » dans la collection de {{ collect.utilisateur.pseudonyme }}</h1>
    </div>

    {{ include('collect/_form.html.twig', {'button_label': 'Enregistrer les modifications'}) }}

    <div class="actions">
        <a class="btn btn--secondary" href="{{ path('app_collect_show', {'id': collect.id}) }}">Revenir au jeu</a>
        <a class="btn btn--secondary" href="{{ path('app_utilisateur_show', {'id': collect.utilisateur.id}) }}">Revenir à la collection</a>
        {{ include('collect/_delete_form.html.twig') }}
    </div>
{% endblock %}
