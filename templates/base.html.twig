<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="description" content="Catalogue de jeux vidéo : jeux, genres et éditeurs.">
        <title>{% block title %}Accueil{% endblock %} | Catalogue Jeux Vidéo</title>
        <link rel="icon" href="{{ asset('images/logo.svg') }}" type="image/svg+xml">
        {# Ajoute la classe « js » au plus tôt : le menu mobile n'est replié que si JavaScript est actif #}
        <script>document.documentElement.classList.add('js');</script>
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('css/base.css') }}">
            <link rel="stylesheet" href="{{ asset('css/layout.css') }}">
            <link rel="stylesheet" href="{{ asset('css/components.css') }}">
            <link rel="stylesheet" href="{{ asset('css/forms.css') }}">
        {% endblock %}

        {% block javascripts %}
            <script src="{{ asset('js/app.js') }}" defer></script>
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        <a class="skip-link" href="#contenu">Aller au contenu</a>

        <header class="site-header">
            <div class="container site-header__inner">
                <a class="brand" href="{{ path('index') }}">
                    <img src="{{ asset('images/logo.svg') }}" alt="" width="40" height="40">
                    <span>Catalogue Jeux Vidéo</span>
                </a>

                <button class="menu-toggle" type="button" aria-controls="menu-principal" aria-expanded="false">
                    <span class="menu-toggle__bar" aria-hidden="true"></span>
                    <span class="menu-toggle__label">Menu</span>
                </button>

                <nav id="menu-principal" class="main-nav" aria-label="Menu principal">
                    {{ knp_menu_render('main', {
                        'template': 'menu/main_menu.html.twig',
                        'depth': 1,
                        'currentClass': 'is-current',
                        'ancestorClass': 'is-current-ancestor',
                    }) }}
                </nav>
            </div>
        </header>

        <div class="container">
            {{ include('partials/_breadcrumb.html.twig') }}
        </div>

        <main id="contenu" class="container site-main" tabindex="-1">
            {{ include('_flash_messages.html.twig') }}
            {% block body %}{% endblock %}
        </main>

        <footer class="site-footer">
            <div class="container site-footer__inner">
                <p>Catalogue Jeux Vidéo — Projet Symfony R5A.05, BUT Informatique 3<sup>e</sup> année</p>
                <p>Yael Betton — G8 · {{ 'now'|date('Y') }}</p>
            </div>
        </footer>
    </body>
</html>
