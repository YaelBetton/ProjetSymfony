{# Messages flash (succès / erreur) ajoutés par les contrôleurs via addFlash().
   Inclus une seule fois, dans base.html.twig. #}
{% for type, messages in app.flashes(['success', 'error']) %}
    {% for message in messages %}
        <p class="flash flash--{{ type }}" role="{{ type == 'error' ? 'alert' : 'status' }}">{{ message }}</p>
    {% endfor %}
{% endfor %}
