{% extends 'base.html.twig' %}

{% block title %}Modifier le genre {{ genre.nom }}{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>Modifier le genre {{ genre.nom }}</h1>
    </div>

    {{ include('genre/_form.html.twig', {'button_label': 'Enregistrer les modifications'}) }}

    <div class="actions">
        <a class="btn btn--secondary" href="{{ path('app_genre_show', {'id': genre.id}) }}">Revenir au genre</a>
        <a class="btn btn--secondary" href="{{ path('app_genre_index') }}">Revenir à la liste</a>
        {{ include('genre/_delete_form.html.twig') }}
    </div>
{% endblock %}
