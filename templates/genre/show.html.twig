{% extends 'base.html.twig' %}

{% block title %}Genre {{ genre.nom }}{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>Genre {{ genre.nom }}</h1>
    </div>

    <table class="table table--detail">
        <caption class="visually-hidden">Détail du genre {{ genre.nom }}</caption>
        <tbody>
            <tr>
                <th scope="row">Nom</th>
                <td>{{ genre.nom }}</td>
            </tr>
            <tr>
                <th scope="row">Description</th>
                <td>{{ genre.description|nl2br }}</td>
            </tr>
            <tr>
                <th scope="row">Statut</th>
                <td>{{ include('genre/_statut.html.twig') }}</td>
            </tr>
            <tr>
                <th scope="row">Nombre de jeux</th>
                <td>{{ genre.jeuVideos|length }}</td>
            </tr>
            <tr>
                <th scope="row">Date de création</th>
                <td>{{ genre.createdAt ? genre.createdAt|date('d/m/Y H:i') : '' }}</td>
            </tr>
            <tr>
                <th scope="row">Date de modification</th>
                <td>{{ genre.updatedAt ? genre.updatedAt|date('d/m/Y H:i') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <div class="actions">
        <a class="btn btn--secondary" href="{{ path('app_genre_index') }}">Revenir à la liste</a>
        <a class="btn btn--primary" href="{{ path('app_genre_edit', {'id': genre.id}) }}">Modifier ce genre</a>
        {{ include('genre/_delete_form.html.twig') }}
    </div>
{% endblock %}
