{% extends 'base.html.twig' %}

{% block title %}Genre {{ genre.nom }}{% endblock %}

{% block body %}
    <h1>Genre {{ genre.nom }}</h1>

    {{ include('_flash_messages.html.twig') }}

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ genre.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ genre.nom }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ genre.description|nl2br }}</td>
            </tr>
            <tr>
                <th>Actif</th>
                <td>{{ genre.actif ? 'Oui' : 'Non' }}</td>
            </tr>
            <tr>
                <th>Nombre de jeux</th>
                <td>{{ genre.jeuVideos|length }}</td>
            </tr>
            <tr>
                <th>Date de création</th>
                <td>{{ genre.createdAt ? genre.createdAt|date('d/m/Y H:i') : '' }}</td>
            </tr>
            <tr>
                <th>Date de modification</th>
                <td>{{ genre.updatedAt ? genre.updatedAt|date('d/m/Y H:i') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_genre_index') }}">Retour à la liste des genres</a>
    <a href="{{ path('app_genre_edit', {'id': genre.id}) }}">Modifier ce genre</a>

    {{ include('genre/_delete_form.html.twig') }}
{% endblock %}
