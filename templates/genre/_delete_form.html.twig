<form class="inline-form" method="post" action="{{ path('app_genre_delete', {'id': genre.id}) }}" onsubmit="return confirm('Confirmer la suppression du genre « {{ genre.nom|e('js') }} » ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ genre.id) }}">
    <button type="submit" class="btn btn--danger">Supprimer ce genre</button>
</form>
