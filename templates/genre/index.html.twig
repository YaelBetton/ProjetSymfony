{% extends 'base.html.twig' %}

{% block title %}Liste des genres{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>Liste des genres</h1>
        <a class="btn btn--primary" href="{{ path('app_genre_new') }}">Ajouter un genre</a>
    </div>

    <div class="table-responsive">
        <table class="table">
            <caption class="visually-hidden">Liste des genres ({{ genres|length }})</caption>
            <thead>
                <tr>
                    <th scope="col">Nom</th>
                    <th scope="col">Description</th>
                    <th scope="col">Statut</th>
                    <th scope="col" class="text-end">Nombre de jeux</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for genre in genres %}
                <tr>
                    <td><strong>{{ genre.nom }}</strong></td>
                    <td>{{ genre.description }}</td>
                    <td>{{ include('genre/_statut.html.twig') }}</td>
                    <td class="text-end">{{ genre.jeuVideos|length }}</td>
                    <td>
                        <div class="actions actions--table">
                            <a class="btn btn--secondary btn--sm" href="{{ path('app_genre_show', {'id': genre.id}) }}">Consulter<span class="visually-hidden"> {{ genre.nom }}</span></a>
                            <a class="btn btn--secondary btn--sm" href="{{ path('app_genre_edit', {'id': genre.id}) }}">Modifier<span class="visually-hidden"> {{ genre.nom }}</span></a>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="table__empty">Aucun genre enregistré.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
