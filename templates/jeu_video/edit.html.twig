{% extends 'base.html.twig' %}

{% block title %}Modifier le jeu {{ jeu_video.titre }}{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>Modifier le jeu {{ jeu_video.titre }}</h1>
    </div>

    {{ include('jeu_video/_form.html.twig', {'button_label': 'Enregistrer les modifications'}) }}

    <div class="actions">
        <a class="btn btn--secondary" href="{{ path('app_jeu_video_show', {'id': jeu_video.id}) }}">Retour au jeu</a>
        <a class="btn btn--secondary" href="{{ path('app_jeu_video_index') }}">Retour à la liste</a>
        {{ include('jeu_video/_delete_form.html.twig') }}
    </div>
{% endblock %}
