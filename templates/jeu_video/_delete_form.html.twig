<form class="inline-form" method="post" action="{{ path('app_jeu_video_delete', {'id': jeu_video.id}) }}" onsubmit="return confirm('Confirmer la suppression du jeu « {{ jeu_video.titre|e('js') }} » ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ jeu_video.id) }}">
    <button type="submit" class="btn btn--danger">Supprimer ce jeu</button>
</form>
