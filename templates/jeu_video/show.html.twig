{% extends 'base.html.twig' %}

{% block title %}Jeu vidéo {{ jeu_video.titre }}{% endblock %}

{% block body %}
    <h1>Jeu vidéo {{ jeu_video.titre }}</h1>

    {% for message in app.flashes('success') %}
        <p class="flash flash-success">{{ message }}</p>
    {% endfor %}

    {% if jeu_video.imageUrl %}
        <img src="{{ app.request.basePath }}/{{ jeu_video.imageUrl }}" alt="{{ jeu_video.titre }}" width="250">
    {% endif %}

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ jeu_video.id }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ jeu_video.titre }}</td>
            </tr>
            <tr>
                <th>Genre</th>
                <td>{{ jeu_video.genre ? jeu_video.genre.nom : '' }}</td>
            </tr>
            <tr>
                <th>Éditeur</th>
                <td>{{ jeu_video.editeur ? jeu_video.editeur.nom : '' }}</td>
            </tr>
            <tr>
                <th>Développeur</th>
                <td>{{ jeu_video.developpeur ? jeu_video.developpeur.nom : '' }}</td>
            </tr>
            <tr>
                <th>Date de sortie</th>
                <td>{{ jeu_video.dateSortie ? jeu_video.dateSortie|date('d/m/Y') : '' }}</td>
            </tr>
            <tr>
                <th>Prix</th>
                <td>{{ jeu_video.prix is not null ? jeu_video.prix|number_format(2, ',', ' ') ~ ' €' : '' }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ jeu_video.description|nl2br }}</td>
            </tr>
            <tr>
                <th>Date de création</th>
                <td>{{ jeu_video.createdAt ? jeu_video.createdAt|date('d/m/Y H:i') : '' }}</td>
            </tr>
            <tr>
                <th>Date de modification</th>
                <td>{{ jeu_video.updatedAt ? jeu_video.updatedAt|date('d/m/Y H:i') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_jeu_video_index') }}">Retour à la liste des jeux</a>
    <a href="{{ path('app_jeu_video_edit', {'id': jeu_video.id}) }}">Modifier ce jeu</a>

    {{ include('jeu_video/_delete_form.html.twig') }}
{% endblock %}
