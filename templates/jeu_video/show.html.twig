{% extends 'base.html.twig' %}

{% block title %}Jeu vidéo {{ jeu_video.titre }}{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>{{ jeu_video.titre }}</h1>
    </div>

    <div class="detail">
        {% if jeu_video.imageUrl %}
            <img class="detail__image" src="{{ asset(jeu_video.imageUrl) }}" alt="Jaquette de {{ jeu_video.titre }}">
        {% endif %}

        <table class="table table--detail">
            <caption class="visually-hidden">Détail du jeu {{ jeu_video.titre }}</caption>
            <tbody>
                <tr>
                    <th scope="row">Titre</th>
                    <td>{{ jeu_video.titre }}</td>
                </tr>
                <tr>
                    <th scope="row">Genre</th>
                    <td>{{ jeu_video.genre ? jeu_video.genre.nom : '' }}</td>
                </tr>
                <tr>
                    <th scope="row">Éditeur</th>
                    <td>{{ jeu_video.editeur ? jeu_video.editeur.nom : '' }}</td>
                </tr>
                <tr>
                    <th scope="row">Développeur</th>
                    <td>{{ jeu_video.developpeur ? jeu_video.developpeur.nom : '' }}</td>
                </tr>
                <tr>
                    <th scope="row">Date de sortie</th>
                    <td>{{ jeu_video.dateSortie ? jeu_video.dateSortie|date('d/m/Y') : '' }}</td>
                </tr>
                <tr>
                    <th scope="row">Prix</th>
                    <td>{{ jeu_video.prix is not null ? jeu_video.prix|number_format(2, ',', ' ') ~ ' €' : '' }}</td>
                </tr>
                <tr>
                    <th scope="row">Description</th>
                    <td>{{ jeu_video.description|nl2br }}</td>
                </tr>
                <tr>
                    <th scope="row">Date de création</th>
                    <td>{{ jeu_video.createdAt ? jeu_video.createdAt|date('d/m/Y H:i') : '' }}</td>
                </tr>
                <tr>
                    <th scope="row">Date de modification</th>
                    <td>{{ jeu_video.updatedAt ? jeu_video.updatedAt|date('d/m/Y H:i') : '' }}</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="actions">
        <a class="btn btn--secondary" href="{{ path('app_jeu_video_index') }}">Revenir à la liste</a>
        <a class="btn btn--primary" href="{{ path('app_jeu_video_edit', {'id': jeu_video.id}) }}">Modifier ce jeu</a>
        {{ include('jeu_video/_delete_form.html.twig') }}
    </div>
{% endblock %}
