{% extends 'base.html.twig' %}

{% block title %}Liste des jeux vidéo{% endblock %}

{% block body %}
    <h1>Liste des jeux vidéo</h1>

    {{ include('_flash_messages.html.twig') }}

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Image</th>
                <th>Titre</th>
                <th>Genre</th>
                <th>Éditeur</th>
                <th>Développeur</th>
                <th>Date de sortie</th>
                <th>Prix</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for jeu_video in jeu_videos %}
            <tr>
                <td>{{ jeu_video.id }}</td>
                <td>
                    {% if jeu_video.imageUrl %}
                        <img src="{{ app.request.basePath }}/{{ jeu_video.imageUrl }}" alt="{{ jeu_video.titre }}" width="60">
                    {% endif %}
                </td>
                <td>{{ jeu_video.titre }}</td>
                <td>{{ jeu_video.genre ? jeu_video.genre.nom : '' }}</td>
                <td>{{ jeu_video.editeur ? jeu_video.editeur.nom : '' }}</td>
                <td>{{ jeu_video.developpeur ? jeu_video.developpeur.nom : '' }}</td>
                <td>{{ jeu_video.dateSortie ? jeu_video.dateSortie|date('d/m/Y') : '' }}</td>
                <td>{{ jeu_video.prix is not null ? jeu_video.prix|number_format(2, ',', ' ') ~ ' €' : '' }}</td>
                <td>
                    <a href="{{ path('app_jeu_video_show', {'id': jeu_video.id}) }}">Consulter</a>
                    <a href="{{ path('app_jeu_video_edit', {'id': jeu_video.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="9">Aucun jeu vidéo enregistré.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_jeu_video_new') }}">Ajouter un jeu</a>
{% endblock %}
