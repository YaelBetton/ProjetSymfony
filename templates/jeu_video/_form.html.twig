{{ form_start(form) }}
    {# Erreurs globales du formulaire (ex. jeton CSRF invalide) #}
    {{ form_errors(form) }}

    {{ form_row(form.titre) }}
    {{ form_row(form.genre) }}
    {{ form_row(form.editeur) }}
    {{ form_row(form.developpeur) }}
    {{ form_row(form.dateSortie) }}

    {# Prix : champ numérique suivi du symbole € #}
    <div>
        {{ form_label(form.prix) }}
        {{ form_widget(form.prix) }} €
        {{ form_help(form.prix) }}
        {{ form_errors(form.prix) }}
    </div>

    {{ form_row(form.description) }}

    {# Image actuelle (en modification) #}
    {% if jeu_video.imageUrl %}
        <p>
            Image actuelle :<br>
            <img src="{{ app.request.basePath }}/{{ jeu_video.imageUrl }}" alt="{{ jeu_video.titre }}" width="120">
        </p>
    {% endif %}
    {{ form_row(form.image) }}

    <button class="btn">{{ button_label|default('Enregistrer') }}</button>
{{ form_end(form) }}
